<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:id="@id/root"
    android:background="#40888888"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout
        android:id="@id/top_bar"
        android:layout_width="fill_parent"
        android:layout_height="@dimen/topbar_height">
        <ImageButton
            android:id="@id/sync_btn"
            android:background="@drawable/btn_transparent_borderless_dark"
            android:layout_width="56.0dip"
            android:layout_height="fill_parent"
            android:scaleType="center"
            android:layout_alignParentRight="true" />
        <LinearLayout
            android:orientation="horizontal"
            android:id="@id/user"
            android:background="@drawable/btn_transparent_borderless_dark"
            android:clickable="true"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:layout_toLeftOf="@id/sync_btn">
            <ImageView
                android:id="@id/user_icon"
                android:padding="8.0dip"
                android:layout_width="48.0dip"
                android:layout_height="fill_parent"
                android:src="@drawable/user_icon"
                android:scaleType="center"
                android:layout_alignParentLeft="true" />
            <TextView
                android:textSize="18.0dip"
                android:textColor="#ffffffff"
                android:gravity="center_vertical"
                android:id="@id/username"
                android:layout_width="0.0dip"
                android:layout_height="fill_parent"
                android:text=""
                android:singleLine="true"
                android:layout_weight="1.0" />
        </LinearLayout>
        <View
            android:id="@id/sep"
            android:background="#ff505050"
            android:layout_width="fill_parent"
            android:layout_height="@dimen/vpixel"
            android:layout_alignParentBottom="true" />
    </RelativeLayout>
    <ListView
        android:id="@id/list"
        android:background="#ffe0e0e0"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:listSelector="@drawable/normal_list_selector_dark"
        android:cacheColorHint="#00000000"
        android:divider="@drawable/divider_sidemenu"
        android:layout_below="@id/top_bar"
        android:overScrollFooter="@null" />
</RelativeLayout>