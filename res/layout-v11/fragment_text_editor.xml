<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:orientation="vertical"
    android:id="@id/root"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <TextSwitcher
        android:id="@id/tutorial_switcher"
        android:background="#aa000000"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content" />
    <LinearLayout
        android:orientation="horizontal"
        android:id="@id/search_bar"
        android:background="@drawable/bg_search_plate"
        android:paddingLeft="5.0dip"
        android:focusable="true"
        android:visibility="gone"
        android:descendantFocusability="afterDescendants"
        android:layout_width="fill_parent"
        android:layout_height="48.0dip"
        android:layout_below="@id/tutorial_switcher">
        <com.socialnmobile.colornote.view.DeviceThemeEditText
            android:textSize="22.0sp"
            android:textColor="#ff000000"
            android:ellipsize="end"
            android:id="@id/edit_search"
            android:background="@drawable/textfield"
            android:paddingLeft="4.0dip"
            android:paddingRight="6.0dip"
            android:layout_width="0.0dip"
            android:layout_height="fill_parent"
            android:layout_marginTop="5.0dip"
            android:layout_marginBottom="5.0dip"
            android:singleLine="true"
            android:layout_weight="1.0"
            android:inputType="textAutoComplete"
            android:imeOptions="actionSearch|flagNoExtractUi" />
        <ImageButton
            android:id="@id/search_btn1"
            android:background="@drawable/btn_transparent_borderless"
            android:layout_width="@dimen/editor_button_width"
            android:layout_height="fill_parent" />
        <ImageButton
            android:id="@id/search_btn2"
            android:background="@drawable/btn_transparent_borderless"
            android:layout_width="@dimen/editor_button_width"
            android:layout_height="fill_parent" />
        <ImageButton
            android:id="@id/search_dismiss"
            android:background="@drawable/btn_transparent_borderless"
            android:layout_width="@dimen/editor_button_width"
            android:layout_height="fill_parent" />
    </LinearLayout>
    <com.socialnmobile.colornote.view.EditorScrollView
        android:id="@id/scroll_view"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:fillViewport="true"
        android:layout_below="@id/search_bar">
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/scrollLinear"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent">
            <include
                android:id="@id/title_bar"
                layout="@layout/include_editor_title" />
            <include
                android:id="@id/conflict"
                android:visibility="gone"
                layout="@layout/include_editor_conflict" />
            <include
                android:id="@id/datetime_info"
                layout="@layout/include_editor_datetime" />
            <com.socialnmobile.colornote.view.LinedEditText
                android:textAppearance="?android:textAppearanceMediumInverse"
                android:gravity="top"
                android:id="@id/edit_note"
                android:background="@null"
                android:padding="5.0dip"
                android:visibility="gone"
                android:scrollbars="vertical"
                android:fadingEdge="vertical"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:maxLength="150000"
                android:inputType="textCapSentences|textMultiLine" />
            <com.socialnmobile.colornote.view.LinedTextView
                android:textAppearance="?android:textAppearanceMediumInverse"
                android:gravity="top"
                android:id="@id/view_note"
                android:background="@null"
                android:padding="5.0dip"
                android:scrollbars="vertical"
                android:fadingEdge="vertical"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:maxLength="150000"
                android:textIsSelectable="true" />
        </LinearLayout>
    </com.socialnmobile.colornote.view.EditorScrollView>
    <ListView
        android:id="@id/suggestion_list"
        android:background="#bb000000"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:scrollingCache="false"
        android:layout_below="@id/search_bar" />
    <TextView
        android:textSize="36.0sp"
        android:textColor="#ff000000"
        android:gravity="center"
        android:id="@id/deleted"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:text="@string/deleted" />
</RelativeLayout>