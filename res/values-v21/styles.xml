<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Compat.CustomDialog.Dark" parent="@style/Theme.Trans.NoTitle.Dark">
        <item name="android:windowBackground">@drawable/dialog_full_dark_material</item>
        <item name="android:textColorAlertDialogListItem">#ffffffff</item>
        <item name="android:windowMinWidthMajor">@android:dimen/dialog_min_width_major</item>
        <item name="android:windowMinWidthMinor">@android:dimen/dialog_min_width_minor</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
        <item name="android:colorControlHighlight">@color/control_highlight_dark</item>
        <item name="android:windowElevation">8.0dip</item>
        <item name="customDialogTabDeviderHeight">1.0dip</item>
        <item name="customDialogButtonDeviderHeight">0.0dip</item>
        <item name="customDialogButtonTextColor">?accentColor</item>
    </style>
    <style name="Compat.CustomDialog.Light" parent="@style/Theme.Trans.NoTitle.Light">
        <item name="android:windowBackground">@drawable/dialog_full_light_material</item>
        <item name="android:textColorAlertDialogListItem">#ff000000</item>
        <item name="android:windowMinWidthMajor">@android:dimen/dialog_min_width_major</item>
        <item name="android:windowMinWidthMinor">@android:dimen/dialog_min_width_minor</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
        <item name="android:colorControlHighlight">@color/control_highlight_light</item>
        <item name="android:windowElevation">8.0dip</item>
        <item name="customDialogTabDeviderHeight">1.0dip</item>
        <item name="customDialogButtonDeviderHeight">0.0dip</item>
        <item name="customDialogButtonTextColor">?accentColor</item>
    </style>
    <style name="TextAppearance.MainToolbarTitle" parent="@style/TextAppearance">
        <item name="android:textSize">22.0sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Compat.NoTitle.Dark" parent="@style/Base.v21.NoTitle.Dark">
        <item name="android:alertDialogTheme">@style/Material.AlertDialog.Dark</item>
    </style>
    <style name="Compat.NoTitle.Light" parent="@style/Base.v21.NoTitle.Light">
        <item name="android:alertDialogTheme">@style/Material.AlertDialog.Light</item>
    </style>
    <style name="Compat.Normal" parent="@style/Base.v21.Normal">
        <item name="android:alertDialogTheme">@style/Material.AlertDialog.Dark</item>
    </style>
    <style name="Compat.Holo.NoTitle.Dark" parent="@style/Base.v14.Holo.NoTitle.Dark">
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">#ff000000</item>
    </style>
    <style name="Compat.Holo.NoTitle.Light" parent="@style/Base.v14.Holo.NoTitle.Light">
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">#ff000000</item>
    </style>
    <style name="Base.v21.ActionBar.Normal" parent="@android:style/Widget.Material.ActionBar.Solid">
        <item name="android:elevation">1.0dip</item>
    </style>
    <style name="Base.v21.Material.Dialog.Alert.Dark" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:colorControlHighlight">@color/control_highlight_dark</item>
    </style>
    <style name="Base.v21.Material.Dialog.Alert.Light" parent="@android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:colorControlHighlight">@color/control_highlight_light</item>
    </style>
    <style name="Base.v21.NoTitle.Dark" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:dropDownSpinnerStyle">@android:style/Widget.Material.Spinner.Underlined</item>
        <item name="android:colorControlHighlight">@color/control_highlight_dark</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">#ff000000</item>
        <item name="dropDownListViewStyle">@android:style/Widget.Material.ListView.DropDown</item>
    </style>
    <style name="Base.v21.NoTitle.Light" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:dropDownSpinnerStyle">@android:style/Widget.Material.Light.Spinner.Underlined</item>
        <item name="android:colorControlHighlight">@color/control_highlight_light</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">#ff000000</item>
        <item name="dropDownListViewStyle">@android:style/Widget.Material.Light.ListView.DropDown</item>
    </style>
    <style name="Base.v21.Normal" parent="@android:style/Theme.Material">
        <item name="android:actionBarStyle">@style/Base.v21.ActionBar.Normal</item>
        <item name="android:dropDownSpinnerStyle">@android:style/Widget.Material.Spinner.Underlined</item>
        <item name="android:colorControlHighlight">@color/control_highlight_dark</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">#ff000000</item>
    </style>
    <style name="Material.AlertDialog.Dark" parent="@style/Base.v21.Material.Dialog.Alert.Dark">
        <item name="android:listPreferredItemPaddingLeft">@dimen/dialog_padding_side</item>
        <item name="android:listPreferredItemPaddingRight">@dimen/dialog_padding_side</item>
        <item name="android:listPreferredItemPaddingStart">@dimen/dialog_padding_side</item>
        <item name="android:listPreferredItemPaddingEnd">@dimen/dialog_padding_side</item>
    </style>
    <style name="Material.AlertDialog.Light" parent="@style/Base.v21.Material.Dialog.Alert.Light">
        <item name="android:listPreferredItemPaddingLeft">@dimen/dialog_padding_side</item>
        <item name="android:listPreferredItemPaddingRight">@dimen/dialog_padding_side</item>
        <item name="android:listPreferredItemPaddingStart">@dimen/dialog_padding_side</item>
        <item name="android:listPreferredItemPaddingEnd">@dimen/dialog_padding_side</item>
    </style>
</resources>
