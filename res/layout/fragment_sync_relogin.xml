<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:fillViewport="true"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <TextView
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="@string/sign_in"
            style="?android:listSeparatorTextViewStyle" />
        <TextView
            android:textColor="#ffffffff"
            android:id="@id/message"
            android:background="#33ffffff"
            android:padding="10.0dip"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10.0dip"
            android:layout_marginTop="10.0dip"
            android:layout_marginRight="10.0dip"
            android:text="@string/msg_connection_expired" />
        <TextView
            android:id="@id/username_label"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10.0dip"
            android:layout_marginTop="5.0dip"
            android:layout_marginRight="10.0dip"
            android:layout_marginBottom="10.0dip"
            android:text="@string/username"
            android:drawablePadding="4.0dip" />
        <TextView
            android:textSize="26.0dip"
            android:gravity="center"
            android:id="@id/username"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10.0dip"
            android:layout_marginRight="10.0dip"
            android:layout_marginBottom="10.0dip"
            android:singleLine="true" />
        <TextView
            android:textSize="20.0dip"
            android:gravity="center"
            android:id="@id/accountInfo"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10.0dip"
            android:layout_marginRight="10.0dip"
            android:layout_marginBottom="10.0dip"
            android:singleLine="true" />
        <Button
            android:textSize="@dimen/buttonTextSizeMedium"
            android:id="@id/fb_signin"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5.0dip"
            android:layout_marginTop="2.0dip"
            android:layout_marginRight="5.0dip"
            android:text="@string/login_with_facebook"
            android:drawableLeft="@drawable/signin_facebook"
            android:drawablePadding="2.0dip" />
        <Button
            android:textSize="@dimen/buttonTextSizeMedium"
            android:id="@id/google_signin"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5.0dip"
            android:layout_marginTop="2.0dip"
            android:layout_marginRight="5.0dip"
            android:text="@string/login_with_google"
            android:drawableLeft="@drawable/signin_google"
            android:drawablePadding="2.0dip" />
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/colornote_group"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2.0dip">
            <TextView
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10.0dip"
                android:layout_marginRight="10.0dip"
                android:layout_marginBottom="10.0dip"
                android:text="@string/password" />
            <EditText
                android:textSize="@dimen/buttonTextSizeMedium"
                android:id="@id/edit_password"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5.0dip"
                android:layout_marginRight="5.0dip"
                android:hint="@string/password"
                android:inputType="textPassword" />
            <Button
                android:textSize="@dimen/buttonTextSizeMedium"
                android:id="@id/colornote_signin"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:layout_marginLeft="5.0dip"
                android:layout_marginRight="5.0dip"
                android:text="@string/sign_in" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>