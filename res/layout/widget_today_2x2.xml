<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:id="@android:id/background"
    android:background="@drawable/bg_widget"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:layout_margin="@dimen/widget_2x2_margin"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout
        android:orientation="horizontal"
        android:id="@id/title_container"
        android:layout_width="fill_parent"
        android:layout_height="28.0dip">
        <ImageView
            android:id="@id/bg_title"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:scaleType="fitXY" />
        <TextView
            android:textSize="@dimen/widget_title_text_size"
            android:textColor="#ff000000"
            android:ellipsize="none"
            android:gravity="center_vertical"
            android:id="@android:id/title"
            android:paddingLeft="4.0dip"
            android:paddingRight="28.0dip"
            android:fadingEdge="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:singleLine="true" />
    </RelativeLayout>
    <RelativeLayout
        android:id="@id/items_container"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_below="@id/title_container">
        <ImageView
            android:id="@id/bg_items"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:scaleType="fitXY" />
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent">
            <ImageView
                android:background="#88444444"
                android:layout_width="fill_parent"
                android:layout_height="1.0px" />
            <RelativeLayout
                android:id="@id/item1"
                android:layout_width="fill_parent"
                android:layout_height="0.0dip"
                android:layout_weight="1.0">
                <ImageView
                    android:id="@id/bg_item1"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:scaleType="fitXY" />
                <TextView
                    android:textSize="@dimen/widget_content_text_size"
                    android:textColor="#ff000000"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:id="@id/text1"
                    android:background="@drawable/btn_transparent"
                    android:padding="3.0dip"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:layout_marginBottom="1.0px"
                    android:singleLine="true" />
                <ImageView
                    android:background="#88444444"
                    android:layout_width="fill_parent"
                    android:layout_height="1.0px"
                    android:layout_alignParentBottom="true" />
            </RelativeLayout>
            <RelativeLayout
                android:id="@id/item2"
                android:layout_width="fill_parent"
                android:layout_height="0.0dip"
                android:layout_weight="1.0">
                <ImageView
                    android:id="@id/bg_item2"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:scaleType="fitXY" />
                <TextView
                    android:textSize="@dimen/widget_content_text_size"
                    android:textColor="#ff000000"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:id="@id/text2"
                    android:background="@drawable/btn_transparent"
                    android:padding="3.0dip"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:layout_marginBottom="1.0px"
                    android:singleLine="true" />
                <ImageView
                    android:background="#88444444"
                    android:layout_width="fill_parent"
                    android:layout_height="1.0px"
                    android:layout_alignParentBottom="true" />
            </RelativeLayout>
            <RelativeLayout
                android:id="@id/item3"
                android:layout_width="fill_parent"
                android:layout_height="0.0dip"
                android:layout_weight="1.0">
                <ImageView
                    android:id="@id/bg_item3"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:scaleType="fitXY" />
                <TextView
                    android:textSize="@dimen/widget_content_text_size"
                    android:textColor="#ff000000"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:id="@id/text3"
                    android:background="@drawable/btn_transparent"
                    android:padding="3.0dip"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:layout_marginBottom="1.0px"
                    android:singleLine="true" />
                <ImageView
                    android:background="#88444444"
                    android:layout_width="fill_parent"
                    android:layout_height="1.0px"
                    android:layout_alignParentBottom="true" />
            </RelativeLayout>
            <RelativeLayout
                android:id="@id/item4"
                android:layout_width="fill_parent"
                android:layout_height="0.0dip"
                android:layout_weight="1.0">
                <ImageView
                    android:id="@id/bg_item4"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:scaleType="fitXY" />
                <TextView
                    android:textSize="@dimen/widget_content_text_size"
                    android:textColor="#ff000000"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:id="@id/text4"
                    android:background="@drawable/btn_transparent"
                    android:padding="3.0dip"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:layout_marginBottom="1.0px"
                    android:singleLine="true" />
                <ImageView
                    android:background="#88444444"
                    android:layout_width="fill_parent"
                    android:layout_height="1.0px"
                    android:layout_alignParentBottom="true" />
            </RelativeLayout>
            <RelativeLayout
                android:id="@id/item5"
                android:layout_width="fill_parent"
                android:layout_height="0.0dip"
                android:layout_weight="1.0">
                <ImageView
                    android:id="@id/bg_item5"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:scaleType="fitXY" />
                <TextView
                    android:textSize="@dimen/widget_content_text_size"
                    android:textColor="#ff000000"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:id="@id/text5"
                    android:background="@drawable/btn_transparent"
                    android:padding="3.0dip"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:layout_marginBottom="1.0px"
                    android:singleLine="true" />
                <ImageView
                    android:background="#88444444"
                    android:layout_width="fill_parent"
                    android:layout_height="1.0px"
                    android:layout_alignParentBottom="true" />
            </RelativeLayout>
        </LinearLayout>
    </RelativeLayout>
    <RelativeLayout
        android:id="@android:id/button1"
        android:paddingBottom="20.0dip"
        android:layout_width="48.0dip"
        android:layout_height="48.0dip"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true">
        <ImageView
            android:background="@drawable/bg_widget_select"
            android:paddingRight="2.0dip"
            android:duplicateParentState="true"
            android:layout_width="30.0dip"
            android:layout_height="28.0dip"
            android:src="@drawable/ic_widget_select"
            android:scaleType="fitEnd"
            android:layout_alignParentRight="true" />
    </RelativeLayout>
</RelativeLayout>