<?xml version="1.0" encoding="utf-8"?>
<com.socialnmobile.colornote.view.BlockRequestRelativeLayout
    android:id="@id/top_bar"
    android:layout_width="fill_parent"
    android:layout_height="@dimen/topbar_height"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <View
        android:id="@id/sep_bottom"
        android:background="#ffaaaaaa"
        android:layout_width="fill_parent"
        android:layout_height="@dimen/vpixel"
        android:layout_alignParentBottom="true" />
    <RelativeLayout
        android:id="@id/top_search"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_above="@id/sep_bottom">
        <com.socialnmobile.colornote.view.DeviceThemeEditText
            android:id="@id/edit_search"
            android:background="@drawable/textfield"
            android:paddingLeft="57.0dip"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:layout_marginLeft="5.0dip"
            android:layout_marginTop="5.0dip"
            android:layout_marginRight="5.0dip"
            android:layout_marginBottom="5.0dip"
            android:hint="@string/search"
            android:singleLine="true"
            android:inputType="text"
            android:imeOptions="actionSearch" />
        <RelativeLayout
            android:background="#00ffffff"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent">
            <ImageView
                android:id="@id/search_back"
                android:background="@drawable/btn_transparent_borderless"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="46.0dip"
                android:layout_height="38.0dip"
                android:layout_marginLeft="5.0dip"
                android:scaleType="center"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true" />
            <ImageButton
                android:id="@id/search_clear"
                android:background="@drawable/btn_transparent_borderless"
                android:layout_width="44.0dip"
                android:layout_height="38.0dip"
                android:layout_marginRight="5.0dip"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true" />
        </RelativeLayout>
    </RelativeLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@id/top_menu"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_above="@id/sep_bottom">
        <RelativeLayout
            android:id="@id/main_logo"
            android:background="@drawable/btn_transparent_borderless"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="0.0dip"
            android:layout_height="fill_parent"
            android:layout_weight="1.0">
            <ImageView
                android:id="@id/img_sidebar"
                android:layout_width="40.0dip"
                android:layout_height="fill_parent"
                android:layout_marginLeft="8.0dip"
                android:layout_marginTop="2.0dip"
                android:layout_marginRight="6.0dip"
                android:layout_marginBottom="2.0dip"
                android:scaleType="center" />
            <TextView
                android:gravity="center|left"
                android:id="@id/main_title"
                android:visibility="invisible"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:text="@string/colornote"
                android:layout_toRightOf="@id/img_sidebar"
                style="@style/TextAppearance.MainToolbarTitle" />
            <ImageView
                android:id="@id/logo_image"
                android:layout_width="wrap_content"
                android:layout_height="fill_parent"
                android:src="@drawable/logo_grayscale_light"
                android:scaleType="center"
                android:layout_toRightOf="@id/img_sidebar" />
            <TextView
                android:textSize="13.0dip"
                android:textColor="#ff888888"
                android:id="@id/logo_extra_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="-10.0dip"
                android:layout_marginTop="2.0dip"
                android:layout_toRightOf="@id/logo_image" />
            <TextView
                android:textSize="14.0sp"
                android:textStyle="bold"
                android:textColor="#ff000000"
                android:gravity="center"
                android:id="@id/noti"
                android:paddingBottom="1.0dip"
                android:visibility="gone"
                android:layout_width="20.0dip"
                android:layout_height="20.0dip"
                android:layout_marginLeft="10.0dip"
                android:text="N"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true" />
        </RelativeLayout>
        <com.socialnmobile.colornote.view.MyImageButton
            android:id="@id/main_btn1"
            android:background="@drawable/btn_transparent_borderless"
            android:visibility="gone"
            android:layout_width="@dimen/screen_button_width"
            android:layout_height="fill_parent" />
        <com.socialnmobile.colornote.view.MyImageButton
            android:id="@id/main_btn2"
            android:background="@drawable/btn_transparent_borderless"
            android:visibility="gone"
            android:layout_width="@dimen/screen_button_width"
            android:layout_height="fill_parent" />
        <com.socialnmobile.colornote.view.MyImageButton
            android:id="@id/main_btn3"
            android:background="@drawable/btn_transparent_borderless"
            android:layout_width="@dimen/screen_button_width"
            android:layout_height="fill_parent" />
    </LinearLayout>
</com.socialnmobile.colornote.view.BlockRequestRelativeLayout>