<?xml version="1.0" encoding="utf-8"?>
<com.socialnmobile.colornote.view.NoChildFocusRelativeLayout
    android:background="@drawable/bg_note_item"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@id/background"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_weight="240.0">
            <View
                android:id="@id/color"
                android:layout_width="@dimen/listLineWidth"
                android:layout_height="fill_parent" />
            <TextView
                android:textAppearance="?android:textAppearanceLarge"
                android:textColor="#ff000000"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@id/title"
                android:paddingRight="2.0dip"
                android:fadingEdge="horizontal"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4.0dip"
                android:singleLine="true"
                android:drawablePadding="4.0dip"
                android:layout_weight="1.0" />
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@id/repeat_image"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="2.0dip"
                android:scaleType="center" />
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@id/type_image"
                android:layout_width="24.0dip"
                android:layout_height="24.0dip"
                android:layout_marginLeft="2.0dip"
                android:scaleType="center" />
        </LinearLayout>
        <TextView
            android:textSize="@dimen/note_item_date_text_size"
            android:textColor="#ff777777"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@id/date"
            android:layout_width="@dimen/note_item_date_width"
            android:layout_height="fill_parent"
            android:layout_marginLeft="2.0dip"
            android:layout_marginRight="2.0dip" />
        <View
            android:id="@id/line_optional"
            android:background="#33000000"
            android:visibility="gone"
            android:layout_width="1.0px"
            android:layout_height="fill_parent"
            android:layout_marginTop="6.0dip"
            android:layout_marginBottom="6.0dip" />
        <ImageButton
            android:gravity="center"
            android:id="@id/btn_optional"
            android:background="@drawable/btn_transparent"
            android:visibility="gone"
            android:layout_width="64.0dip"
            android:layout_height="fill_parent"
            android:scaleType="center" />
    </LinearLayout>
</com.socialnmobile.colornote.view.NoChildFocusRelativeLayout>