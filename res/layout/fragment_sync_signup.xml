<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:fillViewport="true"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/buttonTextSizeMedium"
            android:textStyle="bold"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:padding="10.0dip"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="@string/colornote_online_service" />
        <TextView
            android:textColor="#ffffffff"
            android:gravity="center"
            android:id="@id/tos"
            android:padding="10.0dip"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10.0dip"
            android:layout_marginTop="10.0dip"
            android:layout_marginRight="10.0dip"
            android:layout_marginBottom="10.0dip"
            android:text="@string/terms_of_service" />
        <TextView
            android:textColor="#ffdd0000"
            android:id="@id/message"
            android:background="#33ffffff"
            android:padding="10.0dip"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10.0dip"
            android:layout_marginRight="10.0dip"
            android:layout_marginBottom="5.0dip" />
        <Button
            android:textSize="@dimen/buttonTextSizeMedium"
            android:id="@id/fb_signup"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5.0dip"
            android:layout_marginRight="5.0dip"
            android:text="@string/signup_with_facebook"
            android:drawableLeft="@drawable/signin_facebook"
            android:drawablePadding="2.0dip" />
        <Button
            android:textSize="@dimen/buttonTextSizeMedium"
            android:id="@id/google_signup"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5.0dip"
            android:layout_marginTop="2.0dip"
            android:layout_marginRight="5.0dip"
            android:text="@string/signup_with_google"
            android:drawableLeft="@drawable/signin_google"
            android:drawablePadding="2.0dip" />
        <View
            android:layout_width="fill_parent"
            android:layout_height="0.0dip"
            android:layout_weight="1.0" />
    </LinearLayout>
</ScrollView>