<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="horizontal"
    android:paddingLeft="?dialogListItemPadding"
    android:paddingRight="?dialogListItemPadding"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/common_list_item_height"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <ImageView
        android:layout_gravity="center"
        android:id="@id/icon"
        android:layout_width="30.0dip"
        android:layout_height="30.0dip"
        android:scaleType="centerInside" />
    <TextView
        android:textColor="?dialogListTextColor"
        android:gravity="center_vertical"
        android:id="@id/text"
        android:paddingLeft="6.0dip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/common_list_item_height"
        style="@style/textAppearanceListItem" />
</LinearLayout>