<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:fillViewport="true"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <TextView
            android:id="@id/separator_sync"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="@string/online_sync"
            style="?android:listSeparatorTextViewStyle" />
        <TextView
            android:textColor="#ffdd0000"
            android:id="@id/message"
            android:background="#33ffffff"
            android:padding="10.0dip"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10.0dip"
            android:layout_marginTop="10.0dip"
            android:layout_marginRight="10.0dip" />
        <Button
            android:textSize="@dimen/buttonTextSizeMedium"
            android:id="@id/fb_signin"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5.0dip"
            android:layout_marginTop="5.0dip"
            android:layout_marginRight="5.0dip"
            android:text="@string/login_with_facebook"
            android:drawableLeft="@drawable/signin_facebook"
            android:drawablePadding="2.0dip" />
        <Button
            android:textSize="@dimen/buttonTextSizeMedium"
            android:id="@id/google_signin"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5.0dip"
            android:layout_marginTop="1.0dip"
            android:layout_marginRight="5.0dip"
            android:text="@string/login_with_google"
            android:drawableLeft="@drawable/signin_google"
            android:drawablePadding="2.0dip" />
        <Button
            android:textSize="@dimen/buttonTextSizeMedium"
            android:id="@id/email_signin"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5.0dip"
            android:layout_marginTop="1.0dip"
            android:layout_marginRight="5.0dip"
            android:text="@string/login_with_email"
            android:drawableLeft="@drawable/signin_email"
            android:drawablePadding="2.0dip" />
        <LinearLayout
            android:orientation="horizontal"
            android:id="@id/email_container"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2.0dip">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_weight="1.0">
                <EditText
                    android:textSize="@dimen/buttonTextSizeMedium"
                    android:id="@id/edit_email"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5.0dip"
                    android:hint="@string/email"
                    android:inputType="textEmailAddress" />
                <EditText
                    android:textSize="@dimen/buttonTextSizeMedium"
                    android:id="@id/edit_password"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5.0dip"
                    android:hint="@string/password"
                    android:inputType="textPassword" />
            </LinearLayout>
            <Button
                android:textSize="@dimen/buttonTextSizeMedium"
                android:id="@id/colornote_signin"
                android:layout_width="100.0dip"
                android:layout_height="fill_parent"
                android:layout_marginRight="5.0dip"
                android:text="@string/sign_in" />
        </LinearLayout>
        <TextView
            android:textSize="@dimen/buttonTextSizeMedium"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:paddingBottom="2.0dip"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="@string/or" />
        <LinearLayout
            android:orientation="vertical"
            android:background="#44888888"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10.0dip"
            android:layout_marginTop="3.0dip"
            android:layout_marginRight="10.0dip"
            android:layout_marginBottom="5.0dip">
            <TextView
                android:textSize="17.0sp"
                android:textStyle="bold"
                android:textColor="#ffffffff"
                android:paddingLeft="5.0dip"
                android:paddingTop="3.0dip"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="@string/new_to_colornote_sync" />
            <TextView
                android:textColor="#ffffffff"
                android:paddingLeft="5.0dip"
                android:paddingRight="5.0dip"
                android:paddingBottom="3.0dip"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="@string/desc_cloud_service" />
            <Button
                android:textSize="@dimen/buttonTextSizeLarge"
                android:textStyle="bold"
                android:id="@id/btn_sign_up"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2.0dip"
                android:text="@string/sign_up" />
        </LinearLayout>
        <View
            android:layout_width="fill_parent"
            android:layout_height="0.0dip"
            android:layout_weight="1.0" />
    </LinearLayout>
</ScrollView>