<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:id="@id/title_bar"
    android:layout_width="fill_parent"
    android:layout_height="@dimen/topbar_height"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <View
        android:id="@id/focus"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        android:focusedByDefault="true">
        <requestFocus />
    </View>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <com.socialnmobile.colornote.view.MyImageButton
            android:id="@id/back_btn"
            android:background="@drawable/btn_transparent_borderless"
            android:visibility="gone"
            android:layout_width="@dimen/editor_button_width"
            android:layout_height="fill_parent"
            android:scaleType="center" />
        <View
            android:id="@id/sep0"
            android:visibility="gone"
            android:layout_width="5.0dip"
            android:layout_height="fill_parent" />
        <com.socialnmobile.colornote.view.DeviceThemeEditText
            android:textSize="22.0sp"
            android:ellipsize="end"
            android:id="@id/edit_title"
            android:background="@drawable/bg_edit_title"
            android:paddingLeft="4.0dip"
            android:paddingRight="6.0dip"
            android:fadingEdge="horizontal"
            android:layout_width="0.0dip"
            android:layout_height="fill_parent"
            android:layout_marginTop="5.0dip"
            android:layout_marginBottom="5.0dip"
            android:singleLine="true"
            android:maxLength="50"
            android:layout_weight="1.0"
            android:inputType="textCapSentences" />
        <com.socialnmobile.colornote.view.MyImageButton
            android:id="@id/color_btn"
            android:background="@drawable/btn_transparent_borderless"
            android:visibility="gone"
            android:layout_width="@dimen/editor_button_width"
            android:layout_height="fill_parent"
            android:scaleType="center" />
        <com.socialnmobile.colornote.view.MyImageButton
            android:id="@id/edit_btn"
            android:background="@drawable/btn_transparent_borderless"
            android:layout_width="@dimen/editor_button_width"
            android:layout_height="fill_parent"
            android:scaleType="center" />
        <com.socialnmobile.colornote.view.MyImageButton
            android:id="@id/overflow_btn"
            android:background="@drawable/btn_transparent_borderless"
            android:layout_width="@dimen/editor_button_width"
            android:layout_height="fill_parent"
            android:scaleType="center" />
    </LinearLayout>
    <com.socialnmobile.colornote.view.HorizontalProgressBar
        android:id="@id/progress_bar"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="@dimen/horizontal_progressbar_size"
        android:layout_alignParentBottom="true" />
</RelativeLayout>