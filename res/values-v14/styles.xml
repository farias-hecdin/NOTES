<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Holo.NoTitle.Dark" parent="@style/Compat.Holo.NoTitle.Dark">
        <item name="android:windowBackground">@drawable/screen_background_gray</item>
        <item name="popupMenuStyle">@style/Widget.PopupMenu.Dark</item>
        <item name="normalTextColor">#ffffffff</item>
        <item name="dialogListTextColor">?android:textColorAlertDialogListItem</item>
        <item name="dialogContentStyle">@style/Widget.AlertDialog.Holo</item>
        <item name="dialogContentStyleLess">@style/Widget.AlertDialog.Holo.Less</item>
        <item name="dialogListItemPadding">@dimen/dialog_padding_side_holo</item>
        <item name="dialogNoButtonContentStyle">@style/Widget.AlertDialog.Holo.NoButton</item>
        <item name="dialogNoButtonContentStyleLess">@style/Widget.AlertDialog.Holo.Less.NoButton</item>
        <item name="isLight">false</item>
    </style>
    <style name="Theme.Holo.NoTitle.Light" parent="@style/Compat.Holo.NoTitle.Light">
        <item name="android:windowBackground">@drawable/screen_background_gray</item>
        <item name="popupMenuStyle">@style/Widget.PopupMenu.Light</item>
        <item name="normalTextColor">#ff000000</item>
        <item name="dialogListTextColor">?android:textColorAlertDialogListItem</item>
        <item name="dialogContentStyle">@style/Widget.AlertDialog.Holo</item>
        <item name="dialogContentStyleLess">@style/Widget.AlertDialog.Holo.Less</item>
        <item name="dialogListItemPadding">@dimen/dialog_padding_side_holo</item>
        <item name="dialogNoButtonContentStyle">@style/Widget.AlertDialog.Holo.NoButton</item>
        <item name="dialogNoButtonContentStyleLess">@style/Widget.AlertDialog.Holo.Less.NoButton</item>
        <item name="isLight">true</item>
    </style>
    <style name="Theme.Holo.Trans.NoTitle.Dark" parent="@style/Theme.Holo.NoTitle.Dark">
        <item name="android:windowBackground">@color/transparent</item>
        <item name="android:windowFrame">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
    </style>
    <style name="Theme.Holo.Trans.NoTitle.Light" parent="@style/Theme.Holo.NoTitle.Light">
        <item name="android:windowBackground">@color/transparent</item>
        <item name="android:windowFrame">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
    </style>
    <style name="textAppearanceListItem">
        <item name="android:textAppearance">?android:textAppearanceMedium</item>
    </style>
    <style name="Compat.NoTitle.Dark" parent="@style/Base.v14.NoTitle.Dark">
        <item name="android:spinnerDropDownItemStyle">@android:style/Widget.Holo.DropDownItem.Spinner</item>
        <item name="android:spinnerItemStyle">@android:style/Widget.Holo.TextView.SpinnerItem</item>
        <item name="android:dropDownSpinnerStyle">@android:style/Widget.Holo.Spinner</item>
    </style>
    <style name="Compat.NoTitle.Light" parent="@style/Base.v14.NoTitle.Dark">
        <item name="android:spinnerDropDownItemStyle">@android:style/Widget.Holo.Light.DropDownItem.Spinner</item>
        <item name="android:spinnerItemStyle">@android:style/Widget.Holo.Light.TextView.SpinnerItem</item>
        <item name="android:dropDownSpinnerStyle">@android:style/Widget.Holo.Light.Spinner</item>
        <item name="android:textCursorDrawable">@drawable/text_cursor_holo_light</item>
    </style>
    <style name="Compat.Normal" parent="@android:style/Theme.DeviceDefault" />
    <style name="Base.v14.Holo.NoTitle.Dark" parent="@android:style/Theme.Holo.NoActionBar">
        <item name="dropDownListViewStyle">@style/Widget.Note.ListView.DropDown.Dark</item>
    </style>
    <style name="Base.v14.Holo.NoTitle.Light" parent="@android:style/Theme.Holo.Light.NoActionBar">
        <item name="dropDownListViewStyle">@style/Widget.Note.ListView.DropDown.Light</item>
    </style>
    <style name="Base.v14.NoTitle.Dark" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:textCursorDrawable">@drawable/text_cursor_holo_dark</item>
        <item name="dropDownListViewStyle">@style/Widget.Note.ListView.DropDown.Dark</item>
    </style>
    <style name="Base.v14.NoTitle.Light" parent="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:textCursorDrawable">@drawable/text_cursor_holo_light</item>
        <item name="dropDownListViewStyle">@style/Widget.Note.ListView.DropDown.Light</item>
    </style>
    <style name="Compat.Holo.NoTitle.Dark" parent="@style/Base.v14.Holo.NoTitle.Dark" />
    <style name="Compat.Holo.NoTitle.Light" parent="@style/Base.v14.Holo.NoTitle.Light" />
</resources>
