<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Compat.CustomDialog.Dark" parent="@style/Theme.Trans.NoTitle.Dark">
        <item name="android:windowBackground">@drawable/dialog_full_dark</item>
        <item name="android:textColorAlertDialogListItem">#ffffffff</item>
        <item name="android:windowMinWidthMajor">@android:dimen/dialog_min_width_major</item>
        <item name="android:windowMinWidthMinor">@android:dimen/dialog_min_width_minor</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
        <item name="customDialogTabDeviderHeight">1.0dip</item>
        <item name="customDialogButtonDeviderHeight">1.0dip</item>
        <item name="customDialogButtonTextColor">?normalTextColor</item>
    </style>
    <style name="Compat.CustomDialog.Light" parent="@style/Theme.Trans.NoTitle.Light">
        <item name="android:windowBackground">@drawable/dialog_full_light</item>
        <item name="android:textColorAlertDialogListItem">#ff000000</item>
        <item name="android:windowMinWidthMajor">@android:dimen/dialog_min_width_major</item>
        <item name="android:windowMinWidthMinor">@android:dimen/dialog_min_width_minor</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
        <item name="customDialogTabDeviderHeight">1.0dip</item>
        <item name="customDialogButtonDeviderHeight">1.0dip</item>
        <item name="customDialogButtonTextColor">?normalTextColor</item>
    </style>
    <style name="Theme.NoTitle.Dark" parent="@style/Compat.NoTitle.Dark">
        <item name="android:windowBackground">@drawable/screen_background_gray</item>
        <item name="popupMenuStyle">@style/Widget.PopupMenu.Dark</item>
        <item name="normalTextColor">#ffffffff</item>
        <item name="dialogListTextColor">?android:textColorAlertDialogListItem</item>
        <item name="dialogContentStyle">@style/Widget.AlertDialog</item>
        <item name="dialogContentStyleLess">@style/Widget.AlertDialog.Less</item>
        <item name="dialogListItemPadding">@dimen/dialog_padding_side</item>
        <item name="dialogNoButtonContentStyle">@style/Widget.AlertDialog.NoButton</item>
        <item name="dialogNoButtonContentStyleLess">@style/Widget.AlertDialog.Less.NoButton</item>
        <item name="isLight">false</item>
    </style>
    <style name="Theme.NoTitle.Light" parent="@style/Compat.NoTitle.Light">
        <item name="android:windowBackground">@drawable/screen_background_gray</item>
        <item name="popupMenuStyle">@style/Widget.PopupMenu.Light</item>
        <item name="normalTextColor">#ff000000</item>
        <item name="dialogListTextColor">?android:textColorAlertDialogListItem</item>
        <item name="dialogContentStyle">@style/Widget.AlertDialog</item>
        <item name="dialogContentStyleLess">@style/Widget.AlertDialog.Less</item>
        <item name="dialogListItemPadding">@dimen/dialog_padding_side</item>
        <item name="dialogNoButtonContentStyle">@style/Widget.AlertDialog.NoButton</item>
        <item name="dialogNoButtonContentStyleLess">@style/Widget.AlertDialog.Less.NoButton</item>
        <item name="isLight">true</item>
    </style>
    <style name="Theme.Normal" parent="@style/Compat.Normal">
        <item name="normalTextColor">#ffffffff</item>
        <item name="dialogListTextColor">?android:textColorAlertDialogListItem</item>
        <item name="dialogContentStyle">@style/Widget.AlertDialog</item>
        <item name="dialogContentStyleLess">@style/Widget.AlertDialog.Less</item>
        <item name="dialogListItemPadding">@dimen/dialog_padding_side</item>
        <item name="dialogNoButtonContentStyle">@style/Widget.AlertDialog.NoButton</item>
        <item name="dialogNoButtonContentStyleLess">@style/Widget.AlertDialog.Less.NoButton</item>
        <item name="isLight">false</item>
    </style>
    <style name="Base.v11.NoTitle.Dark" parent="@android:style/Theme.Holo">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="dropDownListViewStyle">@style/Widget.Note.ListView.DropDown.Dark</item>
    </style>
    <style name="Base.v11.NoTitle.Light" parent="@android:style/Theme.Holo.Light">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="dropDownListViewStyle">@style/Widget.Note.ListView.DropDown.Light</item>
    </style>
    <style name="Compat.NoTitle.Dark" parent="@style/Base.v11.NoTitle.Dark" />
    <style name="Compat.NoTitle.Light" parent="@style/Base.v11.NoTitle.Light" />
    <style name="Compat.Normal" parent="@android:style/Theme.Holo" />
</resources>
